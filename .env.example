# Docker Compose settings. Copy to .env (gitignored) and fill in. Never commit real values.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Optional: creates demo accounts employer@example.com and support@example.com with this password. Never set in production.
DEMO_ACCOUNTS_PASSWORD=
# Optional: enables the AI help assistant (Claude). Without it, the assistant answers from approved help content only.
ANTHROPIC_API_KEY=
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
