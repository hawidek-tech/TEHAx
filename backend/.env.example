# Copy to backend/.env and fill in. backend/.env is gitignored - never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/accessflow
DB_TEST_URL=jdbc:postgresql://localhost:5432/accessflow_test
DB_USERNAME=accessflow
DB_PASSWORD=change-me
# SERVER_PORT=8080
# Optional: demo employer/support accounts (employer@example.com, support@example.com). Never set in production.
# DEMO_ACCOUNTS_PASSWORD=
# Optional: AI help assistant (Claude). Model defaults to claude-opus-5-5 (ACCESSFLOW_AI_MODEL to change).
# ANTHROPIC_API_KEY=
# Production: COOKIE_SECURE=true, ACCESSFLOW_FRONTEND_DIR=/path/to/frontend/dist, ACCESSFLOW_STORAGE_DIR=/path/to/storage

