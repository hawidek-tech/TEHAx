{
  "key": "registration",
  "version": 1,
  "sections": ["account"],
  "steps": [
    { "id": "displayName", "section": "account", "fields": [
      { "id": "displayName", "type": "text", "required": true, "maxLength": 100, "autocomplete": "name", "icon": "user" } ] },
    { "id": "contactMethod", "section": "account", "fields": [
      { "id": "contactMethod", "type": "radio", "required": true, "icon": "contact",
        "options": [ { "value": "phone" }, { "value": "email" } ] } ] },
    { "id": "phone", "section": "account", "showIf": { "field": "contactMethod", "in": ["phone"] }, "fields": [
      { "id": "phone", "type": "tel", "required": true, "autocomplete": "tel", "icon": "phone" } ] },
    { "id": "email", "section": "account", "showIf": { "field": "contactMethod", "in": ["email"] }, "fields": [
      { "id": "email", "type": "email", "required": true, "autocomplete": "email", "icon": "mail" } ] },
    { "id": "password", "section": "account", "fields": [
      { "id": "password", "type": "password", "required": true, "minLength": 8, "maxLength": 128, "voice": false,
        "sensitive": true, "autocomplete": "new-password", "icon": "lock" } ] },
    { "id": "acceptPrivacy", "section": "account", "fields": [
      { "id": "acceptPrivacy", "type": "consent", "required": true, "icon": "shield" } ] }
  ]
}
